{
	"experience": "learning",
	"defaultProvider": "custom",
	"defaultModel": "your-model-id",
	"providers": {
		"custom": {
			"baseUrl": "https://provider.example/v1",
			"api": "openai-completions",
			"apiKey": "",
			"models": [
				{
					"id": "your-model-id",
					"name": "请先配置模型",
					"input": [
						"text"
					],
					"contextWindow": 32768,
					"maxTokens": 4096
				}
			]
		}
	},
	"server": {
		"port": 3200
	},
	"channels": {
		"feishu": {
			"enabled": false,
			"personalOnly": true,
			"allowedUserIds": []
		},
		"wechat": {
			"enabled": false,
			"mode": "bridge",
			"allowedUserIds": [],

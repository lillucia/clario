{
	"name": "clario",
	"version": "0.6.2",
	"private": true,
	"description": "Clario — a focused Web learning workspace built on the Pi SDK",
	"author": "Inno Agent Contributors",
	"type": "module",
	"workspaces": [
		"apps/clario",
		"apps/clario/web",
		"apps/showcase"
	],
	"main": "electron/main.js",
	"scripts": {
		"test": "vitest run",
		"eval:l2-retrieval": "tsx scripts/eval-l2-retrieval.ts",
		"build": "npm --workspace clario run build && npm --workspace clario-web run build",
		"start": "node scripts/start-web.mjs",
		"sandbox": "npm --workspace clario run start -- --sandbox",
		"server": "node scripts/start-web.mjs",
		"server:sandbox": "npm --workspace clario run server -- --sandbox",
		"web:dev": "npm --workspace clario-web run dev",
		"dev:server": "npm --workspace clario run server --",
		"restart": "bash restart-dev.sh",
		"restart:fast": "bash restart-dev.sh --skip-build",
		"electron": "electron .",
		"electron:build": "npm run build && electron-builder --mac",
		"electron:build:win": "npm run build && electron-builder --win",
		"showcase:export": "tsx scripts/export-showcase-cases.ts",
		"showcase:dev": "npm run dev --workspace clario-showcase",
		"showcase:build": "npm run build --workspace clario-showcase",
		"showcase:list": "tsx scripts/export-showcase-cases.ts --list",
		"showcase:view": "node scripts/view-showcase-export.mjs",
		"electron:build:mac:signed": "bash scripts/build-mac-signed.sh",
		"electron:package:mac:signed": "node scripts/check-mac-signing.cjs && electron-builder --config build/electron-builder.mac-signed.cjs --mac dmg --arm64 --publish never && bash scripts/verify-mac-release.sh",
		"test:mac-signing": "node --test scripts/check-mac-signing.test.cjs",
		"baseline:prepare": "node scripts/baseline/cli.mjs prepare",
		"baseline:verify": "node scripts/baseline/cli.mjs verify",
		"baseline:web": "node scripts/baseline/cli.mjs serve",
		"cli": "npm --workspace clario run start --",
		"server:raw": "npm --workspace clario run server --"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"build": {
		"appId": "app.clario.learning",
		"productName": "Clario",
		"afterPack": "scripts/after-pack.cjs",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"electron/**/*",
			"apps/clario/dist/**/*",
			"apps/clario/web/dist/**/*",
			"apps/clario/presets/**/*",
			"apps/clario/scripts/**/*",
			"node_modules/**/*",
			"!node_modules/.cache/**/*"
		],
		"asarUnpack": [
			"**/node_modules/node-pty/**/*",
			"**/node_modules/@homebridge/**/*",
			"**/node_modules/@injaneity/pi-computer-use/**/*",
			"apps/clario/presets/**/*",
			"apps/clario/scripts/**/*"
		],
		"mac": {
			"icon": "build/icon.icns",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64"
					]
				}
			],
			"category": "public.app-category.productivity",
			"darkModeSupport": true
		},
		"dmg": {
			"title": "Clario"
		},
		"linux": {
			"icon": "build/icon.png",
			"category": "Education",
			"artifactName": "${name}-${version}-${arch}.${ext}",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"arm64",
						"x64"
					]
				}
			]
		},
		"win": {
			"icon": "build/icon.png",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "msi",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"perMachine": false
		},
		"msi": {
			"oneClick": false,
			"perMachine": false
		}
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.3.0",
		"concurrently": "^9.2.1",
		"electron": "^42.3.0",
		"electron-builder": "^26.8.1",
		"jsdom": "^30.0.1",
		"shx": "^0.4.0",
		"tailwindcss": "^4.1.7",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"vite": "^6.3.5",
		"vitest": "^3.2.4",
		"xlsx": "file:./vendor/xlsx-0.20.3.tgz"
	},
	"overrides": {
		"@larksuiteoapi/node-sdk": {
			"axios": "^1.16.1"
		},
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		},
		"xlsx": "$xlsx"
	}
}
